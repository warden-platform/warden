# 本地 OIDC 联调配置模板（不含任何真实凭据）
#
# 拓扑：三个服务都在本机，且必须全程使用同一个 host（127.0.0.1）。
#   unauth        127.0.0.1:8080   IdP；其 .env 中 OIDC_ISSUER=http://127.0.0.1:8080
#   pam-control   127.0.0.1:8090   PAM_PORT=8090（避开 unauth 占用的 8080）
#   vite          127.0.0.1:8081   前端 + /api 代理到 8090；OIDC 回调落在 8081 同源
#
# ⚠️ 不要混用 localhost 与 127.0.0.1：unauth 的 redirect_uris 是精确全等白名单，
#    两者 host 不同还会导致 state/nonce cookie 不在同一域，回调必然失败。
# ⚠️ 回调落在 vite(8081) 而不是 pam-control(8090)：后者不托管 SPA，
#    登录成功后 302 到 / 会 404。
#
# unauth 侧 RP 客户端（表 rp_clients）：
#   client_id       在 unauth 注册时生成，填到下面 PAM_OIDC_CLIENT_ID
#   redirect_uris   必须与 PAM_OIDC_REDIRECT_URL 逐字符一致
#   allowed_scopes  openid profile email
#   client_secret   明文仅创建/轮转时返回一次，库里只有 bcrypt hash，
#                   写入 .secrets/oidc_client_secret（单行、无引号、无多余空行）
#
# 用法：
#   1. cp scripts/oidc-local.env.example .secrets/oidc-local.env 并填入真实值
#   2. set -a; source .secrets/oidc-local.env; set +a
#   3. make server-build && scripts/start-local-control.sh
#   4. 另一个终端启动前端：
#        PAM_WEB_PORT=8081 PAM_WEB_HOST=127.0.0.1 \
#        PAM_CONTROL_TARGET=http://127.0.0.1:8090 npm --prefix web run dev
#   5. 验证：
#        curl -s http://127.0.0.1:8090/api/v1/auth/oidc/config   -> {"enabled":true}
#        curl -si http://127.0.0.1:8090/api/v1/auth/oidc/start   -> 302 + 两个 Set-Cookie
#      浏览器打开 http://127.0.0.1:8081/login 点 SSO。

# unauth 的 OIDC issuer，需能访问 /.well-known/openid-configuration
export PAM_OIDC_ISSUER="http://127.0.0.1:8080"

# 在 unauth 侧注册的 client id
export PAM_OIDC_CLIENT_ID="<unauth rp_clients.client_id>"

# 回调地址必须与 unauth 注册值逐字符一致
export PAM_OIDC_REDIRECT_URL="http://127.0.0.1:8081/api/v1/auth/oidc/callback"

# federated_identities.tenant_id 外键指向 tenants(slug)，本地初始租户是 platform
export PAM_OIDC_DEFAULT_TENANT_ID="platform"

# 首次建档时写入 principals.metadata.role，决定 JWT scope。
#   可选值：user（默认，4 个基础 scope）/ tenant_admin / platform_admin
#   已存在的角色不会被覆盖（管理员在 PAM 里改过角色后，重新登录仍保留）。
# ⚠️ 生产必须保持 user 或 tenant_admin，按 IdP claim 另行授权；
#    platform_admin 仅供本地联调查看全部页面使用。
export PAM_OIDC_DEFAULT_ROLE="user"

# 端口与来源（unauth 已占 8080，pam-control 必须错开）
export PAM_PORT="8090"
export PAM_CORS_ORIGIN="http://127.0.0.1:8081"
export PAM_PUBLIC_CONTROL_URL="http://127.0.0.1:8081"

# 可选：覆盖默认的 secret 文件路径
# export PAM_OIDC_CLIENT_SECRET_FILE="/absolute/path/to/.secrets/oidc_client_secret"

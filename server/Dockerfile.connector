# 默认国内镜像源（Gitee Go / 国内网络可直接构建）；海外构建可 --build-arg 换回官方源。
ARG GO_IMAGE=docker.m.daocloud.io/library/golang:1.26-alpine
ARG RUNTIME_IMAGE=gcr.m.daocloud.io/distroless/static-debian12:nonroot
FROM ${GO_IMAGE} AS build
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}
WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ .
# TARGET 决定构建哪个二进制。Gitee Go build@docker 不支持 buildArgs，
# operator/connector 用同构变体 Dockerfile.operator / Dockerfile.connector
# （仅 TARGET 默认值不同，CI 有同步校验，改本文件须同步变体）。
ARG TARGET=warden-connector
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/app ./cmd/${TARGET}
RUN mkdir -p /out/artifacts/server/bin/linux-amd64 /out/artifacts/server/bin/linux-arm64 /out/artifacts/server/bin/windows-amd64 /out/artifacts/server/bin/macos-amd64 /out/artifacts/server/bin/macos-arm64 && \
    if [ "$TARGET" = "warden-control" ]; then \
      CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/artifacts/server/bin/linux-amd64/warden-linux-connector ./cmd/warden-linux-connector && \
      CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/artifacts/server/bin/linux-amd64/warden-network-connector ./cmd/warden-network-connector && \
      CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/artifacts/server/bin/linux-amd64/warden-linux-helper ./cmd/warden-linux-helper && \
      CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w" -o /out/artifacts/server/bin/linux-arm64/warden-linux-connector ./cmd/warden-linux-connector && \
      CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w" -o /out/artifacts/server/bin/linux-arm64/warden-network-connector ./cmd/warden-network-connector && \
      CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w" -o /out/artifacts/server/bin/linux-arm64/warden-linux-helper ./cmd/warden-linux-helper && \
      CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/artifacts/server/bin/windows-amd64/warden-host-connector-windows-amd64.exe ./cmd/warden-host-connector && \
      CGO_ENABLED=0 GOOS=darwin GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/artifacts/server/bin/macos-amd64/warden-host-connector-macos-amd64 ./cmd/warden-host-connector && \
      CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -trimpath -ldflags="-s -w" -o /out/artifacts/server/bin/macos-arm64/warden-host-connector-macos-arm64 ./cmd/warden-host-connector; \
    fi

FROM ${RUNTIME_IMAGE}
COPY --from=build /out/app /app
# Keep the release self-contained: install-config and download endpoints must
# work in a container without the source repository mounted beside the binary.
COPY deploy/ /app-artifacts/deploy/
COPY server/migrations/ /app-artifacts/server/migrations/
COPY --from=build /out/artifacts/ /app-artifacts/
ENV WARDEN_ARTIFACT_ROOT=/app-artifacts
ENTRYPOINT ["/app"]

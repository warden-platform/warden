# User-provided credentials only. Internal signing/encryption keys are generated
# by scripts/init-local-secrets.sh into var/warden/secrets.json.
# Never commit .env. Non-secret settings belong in config.yaml.
WARDEN_ADMIN_PASSWORD=replace-with-a-unique-admin-password
WARDEN_DATABASE_PASSWORD=replace-with-a-database-password

# Optional integrations and credentials
# WARDEN_AI_API_KEY=
# WARDEN_OIDC_CLIENT_SECRET=
# WARDEN_OPENBAO_ROOT_TOKEN=
# WARDEN_OPA_BEARER_TOKEN=
# WARDEN_DINGTALK_WEBHOOK=
# WARDEN_DINGTALK_SECRET=
# WARDEN_DINGTALK_APP_KEY=
# WARDEN_DINGTALK_APP_SECRET=
# WARDEN_DINGTALK_CARD_TEMPLATE_ID=
# 部署级审批群，仅作用于 platform 租户；业务租户在「钉钉审批」渠道设置中绑定本组织的群
# WARDEN_DINGTALK_OPEN_CONVERSATION_ID=
# WARDEN_DINGTALK_ROBOT_CODE=
# WARDEN_JENKINS_API_TOKEN=

# database.url in config.yaml must not contain credentials.
